# Redirections Cloudflare Pages.
#
# Le site ne genere plus de pages sans prefixe de langue (elles dupliquaient
# /fr/ et /en/). Toutes les anciennes URLs sont rabattues ici sur leur
# equivalent francais, en un seul 301.
#
# L'ordre compte : Cloudflare applique la premiere regle qui correspond, donc
# les renommages precis passent avant les regles generiques a joker.

# --- Racine ---------------------------------------------------------------
/                                       /fr/                                        301

# --- Anciens slugs d'articles (renommes) ----------------------------------
/blog/les-cabines-de-plage              /fr/blog/cabines-de-plage-beach-cabins/      301
/blog/les-cabines-de-plage/             /fr/blog/cabines-de-plage-beach-cabins/      301
/blog/le-char-a-voile                   /fr/blog/char-a-voile-land-sailing/          301
/blog/le-char-a-voile/                  /fr/blog/char-a-voile-land-sailing/          301
/blog/fête-de-la-coquille-ouistreham    /fr/blog/fete-de-la-coquille-scallop-ouistreham/  301
/blog/fête-de-la-coquille-ouistreham/   /fr/blog/fete-de-la-coquille-scallop-ouistreham/  301
/blog/la-jetee-de-luc-sur-mer           /fr/blog/la-jetee-the-pier-de-luc-sur-mer/   301
/blog/la-jetee-de-luc-sur-mer/          /fr/blog/la-jetee-the-pier-de-luc-sur-mer/   301

# --- Pages supprimees -----------------------------------------------------
/authors/jml                            /fr/                                        301
/authors/jml/                           /fr/                                        301
/en/authors/jml                         /en/                                        301
/en/authors/jml/                        /en/                                        301
/villa-tamaris-beachfront-ouistreham-blog   /fr/blog/                               301
/villa-tamaris-beachfront-ouistreham-blog/  /fr/blog/                               301

# --- Anciennes categories accentuees --------------------------------------
/categories/évènement                   /fr/categories/ev%C3%A8nement/              301
/categories/évènement/                  /fr/categories/ev%C3%A8nement/              301

# --- Sections sans prefixe de langue --------------------------------------
# Un joker par section remplace la centaine de lignes enumerees auparavant et
# couvre aussi les URLs qui n'y figuraient pas (/review/, /categories/guide/,
# /tags/meteo/, les articles ajoutes depuis...).
/blog                                   /fr/blog/                                   301
/blog/*                                 /fr/blog/:splat                             301
/categories                             /fr/categories/                             301
/categories/*                           /fr/categories/:splat                       301
/tags                                   /fr/tags/                                   301
/tags/*                                 /fr/tags/:splat                             301
/review                                 /fr/review/                                 301
/review/*                               /fr/review/:splat                           301
/villa-tamaris-beachfront-ouistreham-*  /fr/villa-tamaris-beachfront-ouistreham-:splat  301
