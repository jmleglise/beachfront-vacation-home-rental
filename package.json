    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.41",
    "prettier": "3.3.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.6.6",
    "sass": "1.77.8",
    "sharp": "^0.34.5",
    "tailwind-bootstrap-grid": "5.1.0",
    "tailwindcss": "3.4.10",
    "typescript": "^6.0.3"
