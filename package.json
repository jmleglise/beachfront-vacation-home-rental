    "format": "prettier -w ./src",
    "check": "astro check",
    "generate-json": "node scripts/jsonGenerator.cjs",
    "remove-multilang": "node scripts/removeMultilang.cjs && yarn format"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/react": "^5.0.5",
    "@astrojs/rss": "^4.0.18",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/signika": "^5.3.0",
    "@radix-ui/react-popover": "^1.1.15",
    "astro": "^6.3.8",
    "astro-auto-import": "0.5.2",
    "date-fns": "^4.2.1",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "lucide-react": "^1.16.0",
    "marked": "13.0.0",
    "photoswipe": "5.4.4",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "18.3.1",
    "react-icons": "5.3.0",
    "react-lite-youtube-embed": "2.4.0",
