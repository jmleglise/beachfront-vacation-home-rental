---
import BlogCard from "@/components/BlogCard.astro";
import Share from "@/components/Share.astro";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser";
import dateFormat from "@/lib/utils/dateFormat";
import { getTranslations, slugSelector } from "@/lib/utils/languageParser";
import similarItems from "@/lib/utils/similarItems";
import { humanize, slugify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { render, type DataEntryMap } from "astro:content";
import { CalendarDays, Folder, UserRound } from "lucide-react";

const { default_language } = config.settings;

const COLLECTION_FOLDER = "blog";
const { post } = Astro.props;
let { lang } = Astro.params;

if (!lang) {
  lang = default_language;
}

const t = await getTranslations(lang as string);
const posts = await getSinglePage(
  COLLECTION_FOLDER,
  lang as keyof DataEntryMap,
);
const similarPosts = similarItems(post, posts).slice(0, 3);
const { Content } = await render(post as any);
const { title, description, author, categories, image, date, tags } = post.data;

const call_to_action = await getSinglePage(
  "sections",
  lang as keyof DataEntryMap,
  "call-to-action",
);
---

<PageHeader title={title} image={image} />

<div class="page-body pt-6 md:pt-8">
  <div class="container">
    <div class="row justify-center">
    <article class="lg:col-10">
      <ul class="meta mb-8">
        {
          author && (
            <li>
              <UserRound aria-hidden="true" />
              <span class="sr-only">{t.author_label} :</span>
              {author}
            </li>
          )
        }
        <li>
          <Folder aria-hidden="true" />
          <span class="sr-only">{t.category_label} :</span>
          {
            categories.map((category: string, index: number) => (
              <a href={slugSelector(`/categories/${slugify(category)}`, lang)}>
                {humanize(category)}
                {index !== categories.length - 1 && ","}
              </a>
            ))
          }
        </li>
        <li>
          <CalendarDays aria-hidden="true" />
          <span class="sr-only">{t.date_label} :</span>
          <time datetime={new Date(date).toISOString()}>{dateFormat(date, lang)}</time>
        </li>
      </ul>
      <div class="content">
        <!-- Encart flottant : le texte de l'article l'englobe. -->
        <aside class="not-prose mb-6 sm:float-right sm:mb-4 sm:ml-8 sm:w-72">
          <CallToAction call_to_action={call_to_action[0]} />
        </aside>
        <Content />
      </div>

      <div class="clear-both mt-12 space-y-6 border-t border-border pt-8">
        {
          tags.length > 0 && (
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="h6 m-0">{t.tags}</h2>
              <ul class="flex flex-wrap gap-2">
                {tags.map((tag: string) => (
                  <li>
                    <a class="tag" href={slugSelector(`/tags/${slugify(tag)}`, lang)}>
                      {humanize(tag)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="h6 m-0">{t.share}</h2>
          <Share
            className="social-icons"
            title={title}
            description={description}
            url={Astro.url.pathname}
          />
        </div>
      </div>
    </article>
    </div>

    {
      similarPosts.length > 0 && (
        <section class="mt-16 border-t border-border pt-12 md:mt-24 md:pt-16">
          <h2 class="section-title">{t.related_posts}</h2>
          <div class="row">
            {similarPosts.map((item) => (
              <div class="mb-10 md:col-6 lg:col-4 lg:mb-0">
                <BlogCard data={item} />
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>
</div>
