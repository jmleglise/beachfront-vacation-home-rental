---
import dateFormat from "@/lib/utils/dateFormat";
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
} from "@/lib/utils/languageParser";
import { humanize } from "@/lib/utils/textConverter";
import ImageMod from "./ImageMod.astro";

// headingLevel : niveau semantique du titre selon la page (h2 sous un H1
// de liste, h3 sous un titre de section). Le style visuel reste .card-title.
const { data, headingLevel = "h3" } = Astro.props;
const { title, image, date, categories } = data.data;

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang as string);

const sourceSlug = data.slug ?? data.id ?? "";
const slugParts = sourceSlug.split("/").filter(Boolean);
if (slugParts[0] !== "blog") {
  slugParts.unshift("blog");
}
if (slugParts[1] === "english" || slugParts[1] === "french") {
  slugParts.splice(1, 1);
}
const modifiedSlug = slugParts.join("/");
const href = slugSelector(`/${modifiedSlug}`, lang);
const Heading = headingLevel;
---

<article class="group relative flex h-full flex-col">
  {
    image && (
      <div class="mb-6 overflow-hidden">
        <ImageMod
          class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          src={image}
          alt=""
          width={640}
          height={480}
          format="webp"
        />
      </div>
    )
  }
  <ul class="meta mb-3">
    {categories.map((category: string) => <li>{humanize(category)}</li>)}
    {date && (
      <li>
        <time datetime={new Date(date).toISOString()}>{dateFormat(date, lang)}</time>
      </li>
    )}
  </ul>
  <Heading class="card-title">
    <!-- Lien etire : toute la carte est cliquable. -->
    <a href={href} class="transition-colors after:absolute after:inset-0 group-hover:text-accent-strong">
      {title}
    </a>
  </Heading>
</article>
