---
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
} from "@/lib/utils/languageParser";
import { ChevronLeft, ChevronRight } from "lucide-react";

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang as string);

type Pagination = {
  section?: string;
  currentPage?: number;
  totalPages?: number;
};
const { section, currentPage = 1, totalPages = 1 }: Pagination = Astro.props;

const base = `/${section ? section : ""}`;
const pageHref = (page: number) =>
  slugSelector(page === 1 ? base : `${base}/page/${page}`, lang);

const hasPrevPage = currentPage > 1;
const hasNextPage = totalPages > currentPage;
const pageList = Array.from({ length: totalPages }, (_, i) => i + 1);
const itemClass =
  "inline-flex h-11 min-w-[44px] items-center justify-center px-3 text-sm font-medium";
---

{
  totalPages > 1 && (
    <nav class="mt-4 flex items-center gap-2" aria-label={t.pagination}>
      {hasPrevPage ? (
        <a href={pageHref(currentPage - 1)} class={`${itemClass} text-dark hover:bg-surface`}>
          <span class="sr-only">{t.previous}</span>
          <ChevronLeft className="h-5 w-5" aria-hidden="true" />
        </a>
      ) : (
        <span class={`${itemClass} text-border`} aria-hidden="true">
          <ChevronLeft className="h-5 w-5" />
        </span>
      )}

      {pageList.map((page) =>
        page === currentPage ? (
          <span aria-current="page" class={`${itemClass} bg-primary text-white`}>
            {page}
          </span>
        ) : (
          <a href={pageHref(page)} class={`${itemClass} text-dark hover:bg-surface`}>
            {page}
          </a>
        ),
      )}

      {hasNextPage ? (
        <a href={pageHref(currentPage + 1)} class={`${itemClass} text-dark hover:bg-surface`}>
          <span class="sr-only">{t.next}</span>
          <ChevronRight className="h-5 w-5" aria-hidden="true" />
        </a>
      ) : (
        <span class={`${itemClass} text-border`} aria-hidden="true">
          <ChevronRight className="h-5 w-5" />
        </span>
      )}
    </nav>
  )
}
