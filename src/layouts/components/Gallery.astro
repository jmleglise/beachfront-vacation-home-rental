---
import type { ImageMetadata } from "astro";
import ImageMod from "@/components/ImageMod.astro";
import GalleryLightboxInit from "../../components/GalleryLightboxInit";

const { images } = Astro.props;

// Dimensions reelles transmises a PhotoSwipe : des valeurs fixes
// (1200x700) deformaient ou recadraient les plans et les photos portrait.
const sources = import.meta.glob<{ default: ImageMetadata }>(
  "/public/images/**/*.{jpeg,jpg,png,gif}",
);
const items = await Promise.all(
  images.map(async (img: any) => {
    const loader = sources[`/public${img.full}`];
    const meta = loader ? (await loader()).default : undefined;
    return { ...img, width: meta?.width ?? 1200, height: meta?.height ?? 800 };
  }),
);
---

<div class="gallery mt-6 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
  {
    items.map((img: any) => (
      <figure>
        <a
          href={img.full}
          data-pswp-width={img.width}
          data-pswp-height={img.height}
          data-cropped="true"
          target="_blank"
          rel="noreferrer"
          class="block overflow-hidden"
        >
          {/* Vignette au ratio de l'original, recadree en CSS seulement :
              PhotoSwipe l'agrandit comme image d'attente pendant
              l'ouverture. Un fichier recadre en 3:2 etait affiche puis
              remplace par la photo entiere, d'ou un saut en fin de zoom. */}
          <ImageMod
            class="aspect-[3/2] w-full object-cover transition-transform duration-300 hover:scale-[1.03]"
            src={img.full}
            width={600}
            alt={img.alt}
            format="webp"
            loading="lazy"
          />
          <span class="hidden-caption-content hidden">{img.title}</span>
        </a>
        <figcaption class="mt-3 text-[11px] font-medium uppercase tracking-label text-light">{img.title}</figcaption>
      </figure>
    ))
  }
</div>

<GalleryLightboxInit client:load />

<style is:global>
  /* Legende PhotoSwipe : element cree hors du composant, d'ou is:global. */
  .pswp__custom-caption {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgb(4 4 4 / 60%);
    color: #fff;
    font-size: 1rem;
    text-align: center;
  }
</style>
