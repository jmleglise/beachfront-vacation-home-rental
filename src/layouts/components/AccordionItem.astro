---
// Equivalent HTML natif du shortcode React Accordion.
// <details>/<summary> est ouvrable au clavier et lu par les lecteurs d'ecran
// sans une ligne de JavaScript : cela evite d'hydrater React (~52 KiB
// transferes) uniquement pour un useState d'ouverture/fermeture.
interface Props {
  title: string;
  class?: string;
}

const { title, class: className = "" } = Astro.props;
---

<details class={`accordion ${className}`}>
  <summary class="accordion-header">
    {title}
    <svg
      class="accordion-icon"
      viewBox="0 0 512 512"
      aria-hidden="true"
      focusable="false"
    >
      <path
        fill="currentColor"
        d="M505.755,123.592c-8.341-8.341-21.824-8.341-30.165,0L256.005,343.176L36.421,123.592c-8.341-8.341-21.824-8.341-30.165,0 s-8.341,21.824,0,30.165l234.667,234.667c4.16,4.16,9.621,6.251,15.083,6.251c5.462,0,10.923-2.091,15.083-6.251l234.667-234.667 C514.096,145.416,514.096,131.933,505.755,123.592z"
      ></path>
    </svg>
  </summary>
  <div class="accordion-content">
    <slot />
  </div>
</details>
