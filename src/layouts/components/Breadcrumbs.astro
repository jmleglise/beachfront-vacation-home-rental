---
import config from "@/config/config.json";
import {
  getLangFromUrl,
  getTranslations,
  supportedLang,
} from "@/lib/utils/languageParser";
import { humanize } from "@/lib/utils/textConverter";
import type { ContentEntryMap } from "astro:content";

const { className }: { className?: string } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const { breadcrumb_home } = await getTranslations(lang as keyof ContentEntryMap);

const segments = Astro.url.pathname.split("/").filter(Boolean);
if (supportedLang.includes(segments[0])) segments.shift();

// Le site est en trailingSlash: "always" : chaque href doit finir par "/",
// sinon on genere un lien interne qui part en redirection.
const homeHref = `/${lang}/`;

type Crumb = { label: string; href: string };
const crumbs: Crumb[] = [{ label: breadcrumb_home, href: homeHref }];

segments.forEach((segment, index) => {
  // "page" n'est qu'un separateur d'URL de pagination (/blog/page/2/).
  if (segment === "page") return;
  crumbs.push({
    label: humanize(decodeURIComponent(segment).replace(/[-_]/g, " ")),
    href: `${homeHref}${segments.slice(0, index + 1).join("/")}/`,
  });
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.label,
    item: `${config.site.base_url}${crumb.href}`,
  })),
};
---

{
  crumbs.length > 1 && (
    <nav aria-label="Breadcrumb" class={className}>
      <ol class="inline-flex flex-wrap justify-center" role="list">
        {crumbs.map((crumb, index) => (
          <li class="mx-1 capitalize">
            {index > 0 && <span class="mr-1 inline-block">/</span>}
            {index !== crumbs.length - 1 ? (
              <a class="text-primary" href={crumb.href}>
                {crumb.label}
              </a>
            ) : (
              <span class="text-light" aria-current="page">
                {crumb.label}
              </span>
            )}
          </li>
        ))}
      </ol>
      <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
      />
    </nav>
  )
}
