---
import config from "@/config/config.json";
import {
  getLangFromUrl,
  getTranslations,
  supportedLang,
} from "@/lib/utils/languageParser";
import { humanize, plainify } from "@/lib/utils/textConverter";

// `title` : libelle du dernier element (titre de la page). Sans lui, le
// libelle etait deduit du slug anglais ("Cabines De Plage Beach Cabins").
const { className, title }: { className?: string; title?: string } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = (await getTranslations(lang as string)) as Record<string, any>;

const segments = Astro.url.pathname.split("/").filter(Boolean);
if (supportedLang.includes(segments[0])) segments.shift();

// Le site est en trailingSlash: "always" : chaque href doit finir par "/",
// sinon on genere un lien interne qui part en redirection.
const homeHref = `/${lang}/`;

const labelFor = (segment: string) =>
  t[`breadcrumb_${segment}`] ??
  humanize(decodeURIComponent(segment).replace(/[-_]/g, " "));

type Crumb = { label: string; href: string };
const crumbs: Crumb[] = [{ label: t.breadcrumb_home, href: homeHref }];

segments.forEach((segment, index) => {
  // "page" n'est qu'un separateur d'URL de pagination (/blog/page/2/).
  if (segment === "page") return;
  const isPageNumber = segments[index - 1] === "page";
  crumbs.push({
    label: isPageNumber ? `${t.breadcrumb_page} ${segment}` : labelFor(segment),
    href: `${homeHref}${segments.slice(0, index + 1).join("/")}/`,
  });
});

if (title && crumbs.length > 1) {
  crumbs[crumbs.length - 1].label = plainify(title);
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.label,
    item: `${config.site.base_url}${crumb.href}`,
  })),
};
---

{
  crumbs.length > 1 && (
    <nav aria-label="Breadcrumb" class={`text-sm ${className ?? ""}`}>
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1" role="list">
        {crumbs.map((crumb, index) => (
          <li class="inline-flex items-center gap-2">
            {index > 0 && (
              <span class="text-light" aria-hidden="true">
                /
              </span>
            )}
            {index !== crumbs.length - 1 ? (
              <a class="text-primary underline-offset-2 hover:underline" href={crumb.href}>
                {crumb.label}
              </a>
            ) : (
              <span class="text-light" aria-current="page">
                {crumb.label}
              </span>
            )}
          </li>
        ))}
      </ol>
      <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
      />
    </nav>
  )
}
