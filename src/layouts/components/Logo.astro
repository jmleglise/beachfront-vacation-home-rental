---
// Logotype unique (header et footer) : camelia + nom de la villa.
import config from "@/config/config.json";
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";
import ImageMod from "./ImageMod.astro";

const { class: className = "", showText = true }: { class?: string; showText?: boolean } =
  Astro.props;

const { logo, logo_width, logo_height, logo_text, logo_alt } = config.site;
const { default_language } = config.settings;

let lang = getLangFromUrl(Astro.url);
const disabledLanguages = config.settings.disable_languages as string[];
if (disabledLanguages.includes(lang)) {
  lang = default_language;
}

const width = Number(logo_width);
const height = Number(logo_height);
---

<a href={slugSelector("/", lang)} class={`navbar-brand ${className}`}>
  <ImageMod
    src={logo}
    class="h-9 w-9 shrink-0 rounded-full md:h-11 md:w-11"
    width={width * 2}
    height={height * 2}
    alt={showText ? "" : logo_alt}
    format="webp"
  />
  {showText && <span>{logo_text}</span>}
</a>
