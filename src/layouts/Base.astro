---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import languagesJSON from "@/config/language.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.scss";
import { ClientRouter } from "astro:transitions";

import { getLangFromUrl } from "@/lib/utils/languageParser";

// font families
const pf = theme.fonts.font_family.primary;
const sf = theme.fonts.font_family.secondary;

export interface Props {
  villa_title?: string;
  title?: string;
  meta_title?: string;
  description?: string;
  schemaVacationRental?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  lang?: string;
}

const {
  title,
  meta_title,
  description,
  schemaVacationRental,
  image,
  noindex,
  canonical,
  lang,
} = Astro.props;

const language = lang || getLangFromUrl(Astro.url);
const pathname = Astro.url.pathname;

const sanitizePath = (path: string) => (path.startsWith("/") ? path : `/${path}`);
const absoluteUrl = (path: string) => `${config.site.base_url}${sanitizePath(path)}`;

const defaultCanonicalUrl = absoluteUrl(pathname);
const canonicalUrl = canonical || defaultCanonicalUrl;

const disabledLanguages = config.settings.disable_languages as string[];
const supportedLocales = languagesJSON
  .map((item) => item.languageCode)
  .filter((locale) => !disabledLanguages.includes(locale));

const localePattern = new RegExp(`^/(?:${supportedLocales.join("|")})(?=/|$)`);
const pathWithoutLocale = pathname.replace(localePattern, "") || "/";

const isExcludedPath = pathname.includes("/categories/") || pathname.includes("/tags/");
const hreflangLinks = !isExcludedPath
  ? supportedLocales.map((locale) => ({
      lang: locale,
      url: absoluteUrl(`/${locale}${pathWithoutLocale === "/" ? "/" : pathWithoutLocale}`),
    }))
  : [];

const ogImage = `${config.site.base_url}${image ? image : config.metadata.meta_image}`;
const seoTitle = plainify(meta_title ? meta_title : title ? title : config.site.title);
const seoDescription = plainify(description ? description : config.metadata.meta_description);
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="author" content={config.metadata.meta_author} />
    <meta name="generator" content={Astro.generator} />

    <link rel="shortcut icon" href={config.site.favicon32} />
    <link rel="icon" type="image/png" sizes="32x32" href={config.site.favicon32} />
    <link rel="icon" type="image/png" sizes="96x96" href={config.site.favicon96} />

    <link rel="canonical" href={canonicalUrl} item-prop="url" />
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.url} />
    ))}
    {hreflangLinks.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(`/${config.settings.default_language}${pathWithoutLocale === "/" ? "/" : pathWithoutLocale}`)} />
    )}

    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />

    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {schemaVacationRental && <Fragment set:html={schemaVacationRental} />}
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fff" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=${pf}&display=swap`} />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=${sf}&display=swap`} />

    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />

    <ClientRouter />
  </head>
  <body>
    <TwSizeIndicator />
    <Header />

    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>