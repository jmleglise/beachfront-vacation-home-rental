---
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
} from "@/lib/utils/languageParser";

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang as string);
const year = new Date().getFullYear();
const linkClass = "inline-block py-1 text-white transition-colors hover:text-accent";
---

<footer class="bg-primary-dark text-white/70">
  <div class="container">
    <div class="row py-16 md:py-24">
      <div class="mb-12 lg:col-5 lg:mb-0">
        <Logo class="text-white" />
        <p class="mt-6 max-w-md text-[15px] font-light leading-[1.8]">{t.seo_footer}</p>
      </div>

      <div class="mb-12 sm:col-6 lg:col-3 lg:mb-0">
        <h2 class="eyebrow text-accent">{t.footer_nav}</h2>
        <ul class="space-y-2 text-[15px]">
          {
            t.main.map((item: any) => (
              <li>
                <a class={linkClass} href={slugSelector(item.url, lang)}>
                  {item.name}
                </a>
              </li>
            ))
          }
          <li>
            <a class={linkClass} href={t.alternativeLang[0].url} hreflang={t.alternativeLang[0].url.replace(/\//g, "")}>
              {t.lang_switch_label}
            </a>
          </li>
        </ul>
      </div>

      <div class="sm:col-6 lg:col-4">
        <h2 class="eyebrow text-accent">{t.footer_contact}</h2>
        <address class="space-y-2 text-[15px] not-italic text-white">
          <p>{t.address}</p>
          <p>
            <!-- Adresse volontairement scindee (texte + image) contre la collecte automatique. -->
            <span class="whitespace-nowrap">villatamaris<img
                src="/images/contact.png"
                alt={lang === "fr" ? "@ location-maison-mer point fr" : "@ location-maison-mer dot fr"}
                width="482"
                height="70"
                class="inline h-[1.458em] w-auto align-[-0.375em] invert"
              /></span>
          </p>
        </address>
        <a class="btn btn-outline-light mt-8" href={slugSelector(config.book_now_button.link, lang)}>
          {t.book_now}
        </a>
      </div>
    </div>
  </div>
  <div class="border-t border-white/15 py-7">
    <div class="container text-[13px]">
      <p>© {year} {config.params.copyright}. {t.footer_rights}</p>
    </div>
  </div>
</footer>
