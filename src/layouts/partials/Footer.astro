---
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
} from "@/lib/utils/languageParser";

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang as string);
const year = new Date().getFullYear();
---

<footer class="bg-primary text-white/85">
  <div class="container">
    <div class="row py-12 md:py-16">
      <div class="mb-10 lg:col-5 lg:mb-0">
        <Logo class="text-white" />
        <p class="mt-4 max-w-measure text-sm leading-relaxed text-white/85">{t.seo_footer}</p>
      </div>

      <div class="mb-10 sm:col-6 lg:col-3 lg:mb-0">
        <h2 class="h6 mb-4 uppercase tracking-wide text-accent">{t.footer_nav}</h2>
        <ul class="space-y-1">
          {
            t.main.map((item: any) => (
              <li>
                <a class="inline-block py-1 text-white/85 hover:text-white hover:underline underline-offset-4" href={slugSelector(item.url, lang)}>
                  {item.name}
                </a>
              </li>
            ))
          }
          <li>
            <a class="inline-block py-1 text-white/85 hover:text-white hover:underline underline-offset-4" href={t.alternativeLang[0].url} hreflang={t.alternativeLang[0].url.replace(/\//g, "")}>
              {t.lang_switch_label}
            </a>
          </li>
        </ul>
      </div>

      <div class="sm:col-6 lg:col-4">
        <h2 class="h6 mb-4 uppercase tracking-wide text-accent">{t.footer_contact}</h2>
        <address class="not-italic">
          <p class="mb-2">{t.address}</p>
          <p class="mb-5">
            <!-- Adresse volontairement scindee (texte + image) contre la collecte automatique. -->
            <span class="whitespace-nowrap text-white">villatamaris<img
                src="/images/contact.png"
                alt={lang === "fr" ? "@ location-maison-mer point fr" : "@ location-maison-mer dot fr"}
                width="528"
                height="72"
                class="inline h-[1.5em] w-auto align-[-0.4375em] invert"
              /></span>
          </p>
        </address>
        <a class="btn border-white bg-white text-primary hover:border-accent hover:bg-accent hover:text-dark" href={slugSelector(config.book_now_button.link, lang)}>
          {t.book_now}
        </a>
      </div>
    </div>
  </div>
  <div class="border-t border-white/15 py-6">
    <div class="container text-sm text-white/70">
      <p>© {year} {config.params.copyright}. {t.footer_rights}</p>
    </div>
  </div>
</footer>
