---
import Logo from "@/components/Logo.astro";

import config from "@/config/config.json";

import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
  supportedLang,
} from "@/lib/utils/languageParser";

let lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang as string);

const { book_now_button, settings } = config;
const { default_language } = config.settings;
const { pathname } = Astro.url;

const disabledLanguages = config.settings.disable_languages as string[];
if (disabledLanguages.includes(lang)) {
  lang = default_language;
}

// Le lien vers l'autre langue conserve la page courante, en coherence avec
// les hreflang declares dans Base.astro.
const alternate = t.alternativeLang[0];
const alternateLang = alternate.url.replace(/\//g, "");
const localePattern = new RegExp(`^/(?:${supportedLang.join("|")})(?=/|$)`);
const pathWithoutLocale = pathname.replace(localePattern, "") || "/";
// Les taxonomies ont des slugs differents par langue (gastronomie/gastronomy) :
// pas d'equivalent fiable, on retombe sur la home.
const hasLocalisedTwin =
  localePattern.test(pathname) &&
  !pathname.includes("/categories/") &&
  !pathname.includes("/tags/");
const alternateUrl = hasLocalisedTwin
  ? `/${alternateLang}${pathWithoutLocale === "/" ? "/" : pathWithoutLocale}`
  : alternate.url;

const bookUrl = slugSelector(book_now_button.link, lang);

// Entree active : correspondance exacte pour l'accueil, par prefixe sinon
// (les articles activent "Decouvertes").
const isActive = (url: string) => {
  const href = slugSelector(url, lang);
  return url === "/" ? pathname === href : pathname.startsWith(href);
};
---

<header class={`header z-30 ${settings.sticky_header ? "sticky top-0" : ""}`}>
  <nav class="navbar container" aria-label={t.main_nav}>
    <Logo class="order-0" />

    {/* navbar toggler : case a cocher masquee visuellement mais focusable */}
    <input
      id="nav-toggle"
      type="checkbox"
      class="peer sr-only"
      aria-controls="nav-menu"
      aria-label={t.menu_open}
    />
    <label
      for="nav-toggle"
      class="order-3 ml-2 flex h-11 w-11 cursor-pointer items-center justify-center rounded text-dark lg:hidden"
    >
      <svg id="show-button" class="block h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="hide-button" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </label>

    <ul
      id="nav-menu"
      class="navbar-nav order-3 hidden w-full pb-4 pt-2 lg:order-1 lg:flex lg:w-auto lg:gap-2 lg:pb-0 lg:pt-0 xl:gap-6"
    >
      {
        t.main.map((item: any) => (
          <li class="nav-item">
            <a
              href={slugSelector(item.url, lang)}
              class={`nav-link ${isActive(item.url) ? "active" : ""}`}
              aria-current={isActive(item.url) ? "page" : undefined}
            >
              {item.name}
            </a>
          </li>
        ))
      }
      <li class="mt-2 border-t border-border pt-2 lg:hidden">
        <a href={alternateUrl} hreflang={alternateLang} lang={alternateLang} class="nav-link">
          {t.lang_switch_label}
        </a>
      </li>
    </ul>

    {/* Actions : reservation (action principale) et changement de langue */}
    <div class="order-1 ml-auto flex items-center gap-2 md:order-2 md:gap-3 lg:ml-0">
      {
        book_now_button.enable && (
          <a class="btn btn-primary btn-sm" href={bookUrl}>
            {t.book_now}
          </a>
        )
      }
      <a
        href={alternateUrl}
        hreflang={alternateLang}
        lang={alternateLang}
        class="lang-switch hidden lg:inline-flex"
        aria-label={t.lang_switch_label}
        title={t.lang_switch_label}
      >
        {t.lang_switch}
      </a>
    </div>
  </nav>
</header>
