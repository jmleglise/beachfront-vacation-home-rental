---
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
} from "@/lib/utils/languageParser";
import { humanize } from "@/lib/utils/textConverter";

const { tags, categories, allCategories } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang as string);
const { pathname } = Astro.url;
---

<aside class="mt-4 lg:col-4 lg:mt-0">
  <div class="card mb-6">
    <h2 class="h5 mb-4">{t.categories}</h2>
    <ul class="space-y-1">
      {
        categories.map((category: any) => {
          const count = allCategories.filter((c: any) => c === category).length;
          const href = slugSelector(`/categories/${category}`, lang);
          return (
            <li>
              <a
                class={`flex min-h-[40px] items-center justify-between rounded px-3 transition-colors hover:bg-body hover:text-primary ${pathname === href ? "bg-body font-semibold text-primary" : ""}`}
                href={href}
                aria-current={pathname === href ? "page" : undefined}
              >
                {humanize(category)}
                <span class="text-sm text-light">{count}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
  <div class="card">
    <h2 class="h5 mb-4">{t.tags}</h2>
    <ul class="flex flex-wrap gap-2">
      {
        tags.map((tag: any) => (
          <li>
            <a class="tag bg-body" href={slugSelector(`/tags/${tag}`, lang)}>
              {humanize(tag)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
