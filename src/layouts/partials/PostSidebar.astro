---
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
} from "@/lib/utils/languageParser";
import { humanize } from "@/lib/utils/textConverter";

const { tags, categories, allCategories } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang as string);
const { pathname } = Astro.url;
---

<aside class="mt-4 lg:col-4 lg:mt-0 lg:pl-8">
  <div class="mb-14">
    <h2 class="eyebrow">{t.categories}</h2>
    <ul class="border-b border-border">
      {
        categories.map((category: any) => {
          const count = allCategories.filter((c: any) => c === category).length;
          const href = slugSelector(`/categories/${category}`, lang);
          return (
            <li>
              <a
                class={`flex min-h-[48px] items-center justify-between border-t border-border transition-colors hover:text-accent-strong ${pathname === href ? "text-accent-strong" : "text-dark"}`}
                href={href}
                aria-current={pathname === href ? "page" : undefined}
              >
                {humanize(category)}
                <span class="text-xs text-light">{count}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
  <div>
    <h2 class="eyebrow">{t.tags}</h2>
    <ul class="flex flex-wrap gap-2">
      {
        tags.map((tag: any) => (
          <li>
            <a class="tag" href={slugSelector(`/tags/${tag}`, lang)}>
              {humanize(tag)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
