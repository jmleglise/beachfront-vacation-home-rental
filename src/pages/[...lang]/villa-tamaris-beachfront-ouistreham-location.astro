---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser";
import { supportedLang } from "@/lib/utils/languageParser";
import { render, type DataEntryMap } from "astro:content";
import PageHeader from "@/partials/PageHeader.astro";
import ImageMod from "@/components/ImageMod.astro";

export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

const { lang } = Astro.params;
const readcontent = await getListPage("location", lang as keyof DataEntryMap);

const { Content } = await render(readcontent[0] as any);
const { title, description, meta_title, image, lead, map, cta } = readcontent[0].data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} lead={lead} image={image} />

  <div class="page-body">
    <div class="container">
      <div class="content">
        <Content />
      </div>
      {
        map && (
          <figure class="mt-12">
            <ImageMod
              src={map.src}
              alt={map.alt}
              width={1272}
              height={636}
              class="w-full"
              loading="lazy"
              format="webp"
            />
            <figcaption class="mt-2 text-sm text-light">{map.alt}</figcaption>
          </figure>
        )
      }
      {cta && <a class="btn btn-outline-primary mt-10" href={cta.link}>{cta.label}</a>}

    </div>
  </div>
</Base>
