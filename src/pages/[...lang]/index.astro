---
import BlogCard from "@/components/BlogCard.astro";
import ImageMod from "@/components/ImageMod.astro";
import AccordionItem from "@/components/AccordionItem.astro";
import Base from "@/layouts/Base.astro";
import { SEASON_PRICING } from "@/config/bookingConstants";
import config from "@/config/config.json";
import { getListPage, getSinglePage } from "@/lib/contentParser";

import {
  getTranslations,
  slugSelector,
  supportedLang,
} from "@/lib/utils/languageParser";
import { markdownify, plainify } from "@/lib/utils/textConverter";

import BannerSlider from "@/partials/BannerSlider.astro";
import type { Feature } from "@/types";
import type { ContentEntryMap } from "astro:content";

export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

const { lang } = Astro.params;
const t = await getTranslations(lang as string);
const homepage = await getListPage("homepage", lang as keyof ContentEntryMap);
const {
  meta_title,
  description,
  schemaVacationRental,
  banner,
  features,
  nous,
  faqContent,
} = homepage[0].data;

const banners = banner.images;

// Decoupe un texte saisi avec des <br> ou des retours a la ligne en
// paragraphes, pour un rendu homogene quel que soit le format du contenu.
const paragraphs = (text: string) =>
  text
    .split(/\n+|<br\s*\/?>/i)
    .map((part) => part.trim())
    .filter(Boolean);

// Chiffres cles : valeur en Cormorant, libelle en capitales espacees.
const keyFigures = [
  { value: "6", label: t.key_guests },
  { value: "3", label: t.key_bedrooms },
  { value: "3", label: t.key_bathrooms },
  { value: t.key_beach_value, label: t.key_beach },
];

// Prix d'appel du bandeau de reservation : tarif le plus bas configure.
const lowestRate = Math.min(
  ...(Object.values(SEASON_PRICING).filter((v) => typeof v === "number") as number[]),
);
const bookUrl = slugSelector(config.book_now_button.link, lang as string);

// Les 6 questions/reponses etaient deja redigees et rendues en HTML, mais
// sans balisage : invisibles pour l'affichage FAQ de Google.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqContent.map(({ title, content }: { title: string; content: string }) => ({
    "@type": "Question",
    name: plainify(title),
    acceptedAnswer: { "@type": "Answer", text: plainify(content) },
  })),
};
const BLOG_FOLDER = "blog";
const posts = await getSinglePage(BLOG_FOLDER, lang as keyof ContentEntryMap);
const shuffledPosts = [...posts].sort(() => 0.5 - Math.random()).slice(0, 3);

const arrow = `<svg viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M0 5h17M13 1l4 4-4 4"/></svg>`;
---
<Base
  meta_title={meta_title}
  description={description}
  schemaVacationRental={schemaVacationRental}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    slot="head"
  />

  <!-- Carrousel, titre integre -->
  <section class="pt-4 md:pt-6">
    <div class="container">
      <div class="relative">
        <div class="overflow-hidden">
          <BannerSlider banners={banners} />
        </div>
        <div class="hero-caption md:pb-16">
          <h1 set:html={markdownify(banner.title)} class="hero-title md:max-w-none" />
        </div>
      </div>

      <!-- Chiffres cles -->
      <h2 class="sr-only">{t.key_figures}</h2>
      <ul class="key-figures">
        {
          keyFigures.map(({ value, label }) => (
            <li>
              <span class="font-secondary text-[2.5rem] font-medium leading-none text-dark [font-variant-numeric:lining-nums] md:text-[3.25rem]">{value}</span>
              <span class="text-[11px] font-medium uppercase tracking-label text-light md:text-xs">{label}</span>
            </li>
          ))
        }
      </ul>

      <!-- Introduction, pleine largeur -->
      <div class="lead space-y-5 py-20 md:py-32">
        {paragraphs(banner.content).map((para) => <p set:html={markdownify(para)} />)}
      </div>
    </div>
  </section>

  <!-- Villa, localisation, region -->
  {
    features.map((feature: Feature, index: number) => (
      <section class={index % 2 === 1 ? "section bg-surface" : index === 0 ? "pb-20 md:pb-32" : "section"}>
        <div class="container">
          <div class="row items-center justify-between">
            <div class={`mb-12 md:col-6 md:mb-0 ${index % 2 !== 0 ? "md:order-2" : ""}`}>
              <ImageMod
                src={feature.image}
                width={720}
                height={880}
                alt={plainify(feature.title)}
                class="aspect-[4/5] w-full object-cover"
                format="webp"
              />
            </div>
            <div class={`md:col-6 lg:col-5 ${index % 2 !== 0 ? "md:order-1" : ""}`}>
              {feature.eyebrow && <span class="eyebrow">{feature.eyebrow}</span>}
              <h2 set:html={markdownify(feature.title)} class="mb-8" />
              <p set:html={markdownify(feature.content)} class="lead mb-8" />
              <ul class="rule-list">
                {feature.bulletpoints.map((bullet: string) => (
                  <li set:html={markdownify(bullet)} />
                ))}
              </ul>
              {feature.button.enable && (
                <a class="btn-link mt-10" href={feature.button.link}>
                  {feature.button.label}
                  <Fragment set:html={arrow} />
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- Vos hotes + FAQ -->
  <section class="section">
    <div class="container">
      <div class="row justify-between">
        <div class="mb-16 lg:col-5 lg:mb-0">
          <span class="eyebrow">{t.eyebrow_hosts}</span>
          <h2 set:html={markdownify(nous.title)} class="mb-8" />
          <div class="lead space-y-5">
            {paragraphs(nous.content).map((para) => <p set:html={markdownify(para)} />)}
          </div>
        </div>

        <div class="lg:col-6">
          <h2 class="eyebrow">{t.eyebrow_faq}</h2>
          <div>
            {faqContent.map(({ title, content }: { title: string; content: string }) => (
              <AccordionItem title={title}>
                <p set:html={markdownify(content)} />
              </AccordionItem>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Carnet -->
  <section class="pb-20 md:pb-32">
    <div class="container">
      <div class="flex flex-wrap items-end justify-between gap-6 border-t border-border pt-20 md:pt-28">
        <div>
          <span class="eyebrow">{t.eyebrow_blog}</span>
          <h2>{t.latest_posts}</h2>
        </div>
        <a class="btn-link" href={slugSelector("/blog", lang as string)}>{t.see_all_posts}</a>
      </div>
      <div class="row mt-12 md:mt-16">
        {
          shuffledPosts.map((post) => (
            <div class="mb-12 md:col-6 lg:col-4 lg:mb-0">
              <BlogCard data={post} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bandeau de reservation -->
  <section class="relative overflow-hidden bg-primary">
    <ImageMod
      src="/images/d_ch5_vue.jpg"
      width={1600}
      height={900}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-40"
      format="webp"
    />
    <div class="container relative flex flex-col items-center gap-6 py-28 text-center text-white md:py-36">
      <span class="eyebrow mb-0 text-accent">{t.eyebrow_booking}</span>
      <h2 class="text-white">{t.cta_title}</h2>
      <p class="lead text-white/90">{t.cta_text.replace("{price}", String(lowestRate))}</p>
      <a class="btn btn-accent mt-2" href={bookUrl}>{t.cta_button}</a>
    </div>
  </section>
</Base>
