---
import BlogCard from "@/components/BlogCard.astro";
import ImageMod from "@/components/ImageMod.astro";
import AccordionItem from "@/components/AccordionItem.astro";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser";

import {
  getTranslations,
  slugSelector,
  supportedLang,
} from "@/lib/utils/languageParser";
import { markdownify, plainify } from "@/lib/utils/textConverter";

import BannerSlider from "@/partials/BannerSlider.astro";
import type { Feature } from "@/types";
import type { ContentEntryMap } from "astro:content";
import { BedDouble, Check, ShowerHead, Users, Waves } from "lucide-react";

export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

const { lang } = Astro.params;
const t = await getTranslations(lang as string);
const homepage = await getListPage("homepage", lang as keyof ContentEntryMap);
const {
  meta_title,
  description,
  schemaVacationRental,
  banner,
  features,
  nous,
  faqContent,
} = homepage[0].data;

const banners = banner.images;

// Decoupe un texte saisi avec des <br> ou des retours a la ligne en
// paragraphes, pour un rendu homogene quel que soit le format du contenu.
const paragraphs = (text: string) =>
  text
    .split(/\n+|<br\s*\/?>/i)
    .map((part) => part.trim())
    .filter(Boolean);

// Chiffres cles : libelles textuels plutot que pictos seuls.
const keyFigures = [
  { icon: Users, value: "6", label: t.key_guests },
  { icon: BedDouble, value: "3", label: t.key_bedrooms },
  { icon: ShowerHead, value: "3", label: t.key_bathrooms },
  { icon: Waves, value: "", label: t.key_beach },
];

// Les 6 questions/reponses etaient deja redigees et rendues en HTML, mais
// sans balisage : invisibles pour l'affichage FAQ de Google.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqContent.map(({ title, content }: { title: string; content: string }) => ({
    "@type": "Question",
    name: plainify(title),
    acceptedAnswer: { "@type": "Answer", text: plainify(content) },
  })),
};
const BLOG_FOLDER = "blog";
const posts = await getSinglePage(BLOG_FOLDER, lang as keyof ContentEntryMap);
const shuffledPosts = [...posts].sort(() => 0.5 - Math.random()).slice(0, 3);
---
<Base
  meta_title={meta_title}
  description={description}
  schemaVacationRental={schemaVacationRental}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    slot="head"
  />

  <!-- Banner -->
  <section class="pt-4 md:pt-6">
    <div class="container">
      <div class="relative">
        <div class="overflow-hidden">
          <BannerSlider banners={banners} />
        </div>
        <!-- H1 sous le carrousel en mobile, en surimpression a partir de md. -->
        <div class="hero-caption md:pb-14">
          <h1 set:html={markdownify(banner.title)} class="hero-title" />
        </div>
      </div>

      <!-- Chiffres cles -->
      <h2 class="sr-only">{t.key_figures}</h2>
      <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5 border-y border-border py-6 md:mt-8 md:grid-cols-4">
        {
          keyFigures.map(({ icon: Icon, value, label }) => (
            <li class="flex items-center gap-3">
              <Icon className="h-7 w-7 shrink-0 text-accent-strong" strokeWidth={1.5} aria-hidden="true" />
              <span class="leading-tight">
                {value && <span class="block font-secondary text-h3-sm font-bold text-dark md:text-h3">{value}</span>}
                <span class="text-sm text-text">{label}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 space-y-4 text-lg md:mt-10">
        {paragraphs(banner.content).map((para) => <p set:html={markdownify(para)} />)}
      </div>
    </div>
  </section>

  <!-- Villa, localisation, activites -->
  <div class="mt-16 md:mt-24">
  {
    features.map((feature: Feature, index: number) => (
      <section class={`section ${index % 2 === 0 ? "bg-surface" : ""}`}>
        <div class="container">
          <div class="row items-start justify-between">
            <div class={`mb-8 md:col-5 md:mb-0 ${index % 2 !== 0 ? "md:order-2" : ""}`}>
              <ImageMod
                src={feature.image}
                width={640}
                height={560}
                alt={feature.title}
                class="aspect-[8/7] w-full object-cover"
                format="webp"
              />
            </div>
            <div class={`md:col-7 lg:col-6 ${index % 2 !== 0 ? "md:order-1" : ""}`}>
              <h2 set:html={markdownify(feature.title)} class="section-title" />
              <p set:html={markdownify(feature.content)} class="mb-6 text-lg" />
              <ul class="check-list">
                {feature.bulletpoints.map((bullet: string) => (
                  <li>
                    <Check aria-hidden="true" />
                    <span set:html={markdownify(bullet)} />
                  </li>
                ))}
              </ul>
              {feature.button.enable && (
                <a class="btn btn-primary mt-6" href={feature.button.link}>
                  {feature.button.label}
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }
  </div>

  <!-- Qui nous sommes + FAQ -->
  <section class="section">
    <div class="container">
      <div class="row justify-between">
        <div class="mb-12 lg:col-6 lg:mb-0">
          <h2 set:html={markdownify(nous.title)} class="section-title" />
          <div class="space-y-4">
            {paragraphs(nous.content).map((para) => <p set:html={markdownify(para)} />)}
          </div>
        </div>

        <div class="lg:col-6 xl:col-5">
          <h2 class="section-title">{t.faq_title}</h2>
          <div class="space-y-3">
            {faqContent.map(({ title, content }: { title: string; content: string }) => (
              <AccordionItem title={title}>
                <p set:html={markdownify(content)} />
              </AccordionItem>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Articles -->
  <section class="section bg-surface">
    <div class="container">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="section-title">{t.latest_posts}</h2>
        <a class="mb-8 font-semibold text-primary underline-offset-4 hover:underline" href={slugSelector("/blog", lang as string)}>
          {t.see_all_posts}
        </a>
      </div>
      <div class="row">
        {
          shuffledPosts.map((post) => (
            <div class="mb-10 md:col-6 lg:col-4 lg:mb-0">
              <BlogCard data={post} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
