---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser";
import { supportedLang } from "@/lib/utils/languageParser";
import { markdownify } from "@/lib/utils/textConverter";
import { render, type DataEntryMap } from "astro:content";
import Gallery from "@/components/Gallery.astro";
import PageHeader from "@/partials/PageHeader.astro";

export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

const { lang } = Astro.params;
const readcontent = await getListPage("feature", lang as keyof DataEntryMap);

const { Content } = await render(readcontent[0] as any);
const { title, description, meta_title, image, lead, detail, cta } = readcontent[0].data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} lead={lead} image={image} />

  <div class="page-body">
    <div class="container">
      {detail.map((item: any) => (
        <section class="mb-12 md:mb-16">
          <div>
            {item.level && <h2 set:html={markdownify(item.level)} class="mb-4" />}
            <div class="content" set:html={markdownify(item.content, true)} />
          </div>
          {item.images && item.images.length > 0 && (
            <Gallery images={item.images} />
          )}
        </section>
      ))}
      <div class="content">
        <Content />
      </div>
      {cta && <a class="btn btn-outline-primary mt-10" href={cta.link}>{cta.label}</a>}
    </div>
  </div>
</Base>
