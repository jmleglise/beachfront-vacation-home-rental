---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
} from "@/lib/utils/languageParser";
import type { ContentEntryMap } from "astro:content";

let lang = getLangFromUrl(Astro.url);

const disabledLanguages = config.settings.disable_languages as string[];
if (disabledLanguages.includes(lang)) {
  lang = config.settings.default_language;
}

const { page_not_found_content, page_not_found, back_to_home } =
  await getTranslations(lang as keyof ContentEntryMap);
---

<Base title={page_not_found} noindex={true}>
  <section class="section">
    <div class="container">
      <div class="max-w-measure">
        <p class="font-secondary text-[5rem] font-bold leading-none text-accent-strong md:text-[7rem]">404</p>
        <h1 class="mt-4">{page_not_found}</h1>
        <p class="mt-4 text-lg">{page_not_found_content}</p>
        <a href={slugSelector("/", lang)} class="btn btn-primary mt-8">{back_to_home}</a>
      </div>
    </div>
  </section>
</Base>
